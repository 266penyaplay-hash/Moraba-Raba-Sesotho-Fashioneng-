rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isRoomPlayer() {
      return isSignedIn() && (
        request.auth.uid == resource.data.hostId ||
        request.auth.uid == resource.data.guestId ||
        (resource.data.guestId == null && request.resource.data.guestId == request.auth.uid)
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /playerProgression/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /playerMastery/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /dailyChallenges/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /tacticalPuzzles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /achievements/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /gameRooms/{roomId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if isRoomPlayer();
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;
    }

    match /playerSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /gameSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /playerCareer/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /headToHead/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
  }
}
